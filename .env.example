# s3clinet docker compose / 本地联调环境变量
# 复制为仓库根目录 .env：cp .env.example .env

# 必填：API 鉴权（compose 内 server 监听 0.0.0.0，无 token 会拒绝启动）
# 生成：openssl rand -hex 32
S3C_TOKEN=change-me-use-openssl-rand-hex-32

# 日志：S3C_LOG_LEVEL=info|debug|warn|error；容器建议 S3C_LOG_JSON=1
# S3C_LOG_JSON=1

# 账号存储（生产建议 encrypted + S3C_STORE_KEY）
S3C_STORE_DRIVER=sqlite
# S3C_STORE_KEY=

# 本地 RustFS 联调凭据（勿用于生产；生产请移除 rustfs 服务）
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
# 浏览器可达的 Origin（收紧 CORS；勿用 *）
RUSTFS_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
