# ===== s3clinet server 环境变量示例 =====
# 复制为 .env 或直接用环境变量导出。

# 监听地址（默认 127.0.0.1:8080，绑定回环更安全；需局域网/远程时改为 0.0.0.0:8080）
S3C_ADDR=127.0.0.1:8080

# 数据目录（存放 accounts.json）
S3C_DATA_DIR=./data

# Web 静态资源目录（构建产物）
S3C_STATIC_DIR=./web/dist

# 账号缺省 region（账号可单独覆盖）
S3C_REGION=us-east-1

# 可选：API 鉴权 Token。非空时所有 /api/* 需携带 Authorization: Bearer <token>
# 生成：openssl rand -hex 32
# 多 token 轮换：逗号分隔，如 tokA,tokB（去掉旧值即吊销）
# 注意：S3C_ADDR 为非回环（如 0.0.0.0）时必须设置，否则进程拒绝启动。
S3C_TOKEN=

# 可选：CORS 白名单（逗号分隔的 Origin 列表）。留空则使用安全默认
#（仅放行同源 + localhost/127.0.0.1/tauri 自定义协议跨域）。
# 示例：S3C_CORS_ORIGINS=https://app.example.com,http://192.168.1.10:1949
# 或 S3C_CORS_ORIGINS=* （不推荐，仅确认明白风险时使用）
S3C_CORS_ORIGINS=

# 日志级别：debug | info | warn | error
S3C_LOG_LEVEL=info
# 可选：JSON 日志（容器/生产更易采集）：S3C_LOG_JSON=1
# S3C_LOG_JSON=1

# 收到 SIGTERM 后等待活跃 HTTP 连接结束的最长时间（秒）；大文件传输可适当加大
S3C_SHUTDOWN_TIMEOUT=30

# 账号存储：json（默认）| sqlite（accounts.db）| encrypted（AES-256-GCM accounts.json.enc，格式 S3C2）
# encrypted 需设置 S3C_STORE_KEY
S3C_STORE_DRIVER=json
S3C_STORE_KEY=
